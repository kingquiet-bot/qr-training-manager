# ── Platform Settings ───────────────────────────────────────
# Master secret for credential encryption and JWT signing
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MASTER_SECRET=your_master_secret_here

# ── OTP email (recommended for Render, including Free) ─────
# Resend sends over HTTPS because Render Free blocks SMTP ports.
# Verify your sending domain, then use an address on that domain.
RESEND_API_KEY=re_your_api_key
OTP_FROM_EMAIL="Training Manager <noreply@your_verified_domain.com>"

# ── SMTP fallback (local development or paid hosts) ────────
# For Gmail, use a 16-character App Password, not your login password.
# SMTP cannot send from a Render Free web service.
# SMTP_EMAIL=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587

# ── Runtime and storage ─────────────────────────────────────
DEV_MODE=false
# Render supplies PORT automatically. Defaults to 5000 locally.
# PORT=10000
# Use a path on a mounted persistent disk in production.
# DATABASE_PATH=/var/data/attendance.db

# Same-origin requests need no CORS entry. Comma-separate any additional
# trusted frontend origins; do not include paths or trailing slashes.
# CORS_ORIGINS=https://admin.example.com,https://app.example.com

# One-time administrator creation (required on Render). Configure both values.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace_with_at_least_12_characters

# ── Google OAuth (optional) ────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Create OAuth 2.0 Client ID (Web application type)
# Add http://localhost:5000 and your production URL to authorized origins
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# ── Telegram (optional) ────────────────────────────────────
# TELEGRAM_BOT_TOKEN=your_token_here

# ── Proxy (optional) ───────────────────────────────────────
# Uncomment and set if bot fails to connect without VPN
# TELEGRAM_PROXY=socks5://user:password@proxy.example.com:1080
