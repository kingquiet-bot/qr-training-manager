# Telegram Bot Token — get one from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_token_here

# SMTP credentials for email reports (optional)
# SMTP_EMAIL=your_email@gmail.com
# SMTP_PASSWORD=your_app_password

# Proxy configuration (optional) — for networks with firewall restrictions
# Uncomment and set if bot fails to connect without VPN
# TELEGRAM_PROXY=socks5://user:password@proxy.example.com:1080
