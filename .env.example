# ── Platform Settings ───────────────────────────────────────
# Master secret for credential encryption and JWT signing
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MASTER_SECRET=your_master_secret_here

# ── Platform SMTP (for OTP verification emails) ────────────
# These are used to send verification codes to new users during registration.
# Change these in the Platform Admin dashboard after first login.
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# ── Google OAuth (optional) ────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Create OAuth 2.0 Client ID (Web application type)
# Add http://localhost:5000 and your production URL to authorized origins
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# ── Telegram (optional) ────────────────────────────────────
# TELEGRAM_BOT_TOKEN=your_token_here

# ── Proxy (optional) ───────────────────────────────────────
# Uncomment and set if bot fails to connect without VPN
# TELEGRAM_PROXY=socks5://user:password@proxy.example.com:1080
